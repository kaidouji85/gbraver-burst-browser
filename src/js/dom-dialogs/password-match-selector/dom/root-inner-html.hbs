<div class="{{ROOT_CLASS}}__background" data-id="background"></div>
<div class="{{ROOT_CLASS}}__dialog">
  <img
    class="{{ROOT_CLASS}}__closer"
    alt="閉じる"
    src="{{closerPath}}"
    data-id="closer"
  />
  <button
    class="{{ROOT_CLASS}}__password-match-host"
    alt="あいことばを作る"
    data-id="password-match-host"
  >
    <div class="{{ROOT_CLASS}}__password-match-host-title">
      🔑あいことば<wbr />を作る
    </div>
  </button>
  <button
    class="{{ROOT_CLASS}}__password-match-guest"
    alt="あいことばで入る"
    data-id="password-match-guest"
  >
    <div class="{{ROOT_CLASS}}__password-match-guest-title">
      🔓あいことば<wbr />で入る
    </div>
  </button>
</div>