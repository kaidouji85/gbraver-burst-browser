<div class="{{ROOT_CLASS}}__dialog">
  <img
    class="{{ROOT_CLASS}}__closer"
    alt="閉じる"
    src="{{closerPath}}"
    data-id="closer"
  />
  <div class="{{ROOT_CLASS}}__qr-code-description">QRコードでバトルスタート！！</div>
  <img alt="QRコード" class="{{ROOT_CLASS}}__qr-code" data-id="qr-code" />
  <div class="{{ROOT_CLASS}}__separator">または</div>
  <div class="{{ROOT_CLASS}}__room-id">
    <div
      class="{{ROOT_CLASS}}__room-id-description"
    >あいことばでバトルスタート！！</div>
    <div class="{{ROOT_CLASS}}__room-id-value" translate="no">
      {{roomID}}
    </div>
    <button class="{{ROOT_CLASS}}__copy-room-id" data-id="copy-room-id">
      コピー
      <div
        class="{{ROOT_CLASS}}__success-copy-room-id"
        data-id="success-copy-room-id"
      >&check; コピーしました</div>
    </button>
  </div>
</div>