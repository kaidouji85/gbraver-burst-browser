<div class="{{ROOT}}__background"></div>
<div class="{{ROOT}}__dialog">
  <div class="{{ROOT}}__armdozer-detail">
    <div class="{{ROOT}}__armdozer-name">シンブレイバー</div>
    <div class="{{ROOT}}__armdozer-basic-status">
      <span class="{{ROOT}}__armdozer-hp">
        <span class="{{ROOT}}__armdozer-hp-label">HP</span>
        <span class="{{ROOT}}__armdozer-hp-value">3100</span>
      </span>
      <span class="{{ROOT}}__armdozer-battery">
        <span class="{{ROOT}}__armdozer-battery-label">
          <img
            class="{{ROOT}}__battery-icon"
            src="{{batteryIconPath}}"
            alt="バッテリーアイコン"
          />
        </span>
        <span class="{{ROOT}}__armdozer-battery-value">5</span>
      </span>
      <span class="{{ROOT}}__armdozer-power">
        <span class="{{ROOT}}__armdozer-power-label">攻撃</span>
        <span class="{{ROOT}}__armdozer-power-value">2000</span>
      </span>
      <span class="{{ROOT}}__armdozer-speed">
        <span class="{{ROOT}}__armdozer-speed-label">機動</span>
        <span class="{{ROOT}}__armdozer-speed-value">2000</span>
      </span>
    </div>
    <div class"{{ROOT}}__burst">バースト詳細</div>
  </div>
  <div class="{{ROOT}}__armdozer-picker" data-id="armdozer-picker"></div>
  <div class="{{ROOT}}__pilot-detail">パイロット詳細</div>
  <div class="{{ROOT}}__pilot-picker" data-id="pilot-picker"></div>
  <div class="{{ROOT}}__actions">
    <button class="{{ROOT}}__goto-title">タイトルへ</button>
    <button class="{{ROOT}}__retry">リトライ</button>
  </div>
</div>