<div
  class="{{ROOT_CLASS}}__dummy-qr-code-reader"
  data-id="dummy-qr-code-reader"
></div>
<div class="{{ROOT_CLASS}}__dialog">
  <img
    class="{{ROOT_CLASS}}__closer"
    alt="閉じる"
    src="{{closerPath}}"
    data-id="closer"
  />
  <div
    class="{{ROOT_CLASS}}__matching-failed"
    data-id="matching-failed"
  >マッチング失敗</div>
  <button
    class="{{ROOT_CLASS}}__start-qr-code-reader"
    data-id="start-qr-code-reader"
  >
    📷QRコードでバトルスタート
  </button>
  <div class="{{ROOT_CLASS}}__separator">または</div>
  <div class="{{ROOT_CLASS}}__room-id-form">
    <div class="{{ROOT_CLASS}}__room-id-description">
      あいことばを入れてね
      <span class="{{ROOT_CLASS}}__room-id-arrow">⬇</span>
    </div>
    <input
      class="{{ROOT_CLASS}}__room-id"
      type="text"
      data-id="roomID"
      value="{{initialRoomID}}"
    />
    <button
      class="{{ROOT_CLASS}}__enter"
      data-id="enterButton"
    >バトルスタート</button>
  </div>
</div>